# Convex (generated by `pnpm dev:backend` after logging in)
CONVEX_DEPLOYMENT=
EXPO_PUBLIC_CONVEX_URL=

# WorkOS AuthKit — public client (no API key in the app)
EXPO_PUBLIC_WORKOS_CLIENT_ID=
EXPO_PUBLIC_WORKOS_REDIRECT_URI=habits://callback

# Convex backend still needs these (set via `npx convex env set` or local .env.local)
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
