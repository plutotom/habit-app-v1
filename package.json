{
  "name": "habit-app-v1",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "convex dev --start 'expo start --dev-client'",
    "dev:ios": "expo start --dev-client",
    "dev:backend": "convex dev",
    "ios": "expo run:ios",
    "start": "expo start --dev-client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p backend",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && expo-doctor",
    "ota:production": "bash ./scripts/publish-ota-production.sh",
    "release:check-env": "bash ./scripts/load-eas-production-env.sh",
    "build:ios:production": "bash ./scripts/build-ios.sh",
    "release:ios:production": "bash ./scripts/release-ios.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@workos-inc/node": "^8.0.0",
    "convex": "^1.42.0",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-standard-web-crypto": "^57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@react-native/metro-config": "0.86.3",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.7",
    "@types/react-test-renderer": "^19.1.0",
    "convex-test": "^0.0.56",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "expo-doctor": "^1.17.14",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
