{
  "functions": "backend/",
  "authKit": {
    "dev": {
      "configure": {
        "redirectUris": ["habits://callback", "http://localhost:4021/callback"],
        "appHomepageUrl": "http://localhost:4021",
        "corsOrigins": ["http://localhost:4021"]
      },
      "localEnvVars": {
        "WORKOS_CLIENT_ID": "${authEnv.WORKOS_CLIENT_ID}",
        "WORKOS_API_KEY": "${authEnv.WORKOS_API_KEY}",
        "EXPO_PUBLIC_WORKOS_CLIENT_ID": "${authEnv.WORKOS_CLIENT_ID}",
        "EXPO_PUBLIC_WORKOS_REDIRECT_URI": "habits://callback"
      }
    },
    "prod": {
      "environmentType": "production",
      "configure": {
        "redirectUris": ["habits://callback"],
        "appHomepageUrl": "https://habits.plutotom.com",
        "corsOrigins": []
      }
    }
  }
}
