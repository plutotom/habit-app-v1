{
  "functions": "backend/",
  "authKit": {
    "dev": {
      "configure": {
        "redirectUris": [
          "http://localhost:4021/callback"
        ],
        "appHomepageUrl": "http://localhost:4021",
        "corsOrigins": ["http://localhost:4021"]
      },
      "localEnvVars": {
        "WORKOS_CLIENT_ID": "${authEnv.WORKOS_CLIENT_ID}",
        "WORKOS_API_KEY": "${authEnv.WORKOS_API_KEY}",
        "NEXT_PUBLIC_WORKOS_REDIRECT_URI": "http://localhost:4021/callback"
      }
    },
    "prod": {
      "environmentType": "production",
      "configure": {
        "redirectUris": ["https://habits.plutotom.com/callback"],
        "appHomepageUrl": "https://habits.plutotom.com",
        "corsOrigins": ["https://habits.plutotom.com"]
      }
    }
  }
}
